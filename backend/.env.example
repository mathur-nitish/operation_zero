# Operation Zero backend — environment variable template.
# Copy to .env and fill in real values. Do not put real secrets in this file.
# Real environment variables override values in .env.

# development | test | production — selects which database below is used.
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# MongoDB Atlas connection string WITHOUT credentials
# e.g. mongodb+srv://cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Atlas database user credentials (kept separate from the URI)
GAME_DATA_DB_USER=
GAME_DATA_DB_PASSWORD=

# One database per environment; all three must be different.
MONGODB_DB_NAME_PROD=operation_zero
MONGODB_DB_NAME_DEV=operation_zero_dev
# Emptied by every test run. Must end with "_test".
MONGODB_DB_NAME_TEST=operation_zero_test

# Signing key for access tokens (HS256), at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every issued access token. Tests use their own key.
JWT_SECRET=
# Optional (defaults shown)
# JWT_ISSUER=operation-zero
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
